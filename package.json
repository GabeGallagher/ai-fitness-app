{
  "name": "fitness-tracker",
  "version": "0.0.1",
  "author": "Gabe",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:integration": "ng test --watch=false --include \"**/*.integration.spec.ts\"",
    "e2e": "playwright test",
    "lint": "ng lint",
    "typecheck": "ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p e2e/tsconfig.json",
    "verify": "npm run lint && npm run typecheck && ng test --watch=false && npm run e2e"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/platform-browser-dynamic": "22.2.5",
    "@angular/router": "22.2.5",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "dexie": "4.4.7",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@playwright/test": "^1.65.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^30.1.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "description": "Personal Android fitness tracker"
}
